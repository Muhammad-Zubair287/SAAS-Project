# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=Workforce Cloud OS
APP_VERSION=0.1.0
APP_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3001

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workforce_cloud_os_dev?schema=public

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT (config only — no auth implementation in this phase) ─────────────────
JWT_SECRET=changeme-in-production-use-minimum-32-random-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── API ─────────────────────────────────────────────────────────────────────
API_PREFIX=api
API_VERSION=v1

# ─── Swagger ─────────────────────────────────────────────────────────────────
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_PRETTY=true

# ─── Throttle ────────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── Upload ──────────────────────────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf

# ─── Health ──────────────────────────────────────────────────────────────────
HEALTH_TIMEOUT=3000

# ─── Web (Next.js public vars) ───────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Workforce Cloud OS
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_VERSION=0.1.0
