# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=Workforce Cloud OS
APP_VERSION=0.1.0
APP_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3001

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workforce_cloud_os_dev?schema=public

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_MAX_RECONNECT_DELAY_MS=30000

# ─── Platform Queues (M00) ───────────────────────────────────────────────────
QUEUE_DEFAULT_ATTEMPTS=5
QUEUE_RETRY_DELAY_MS=1000
QUEUE_RETRY_MAX_DELAY_MS=300000
QUEUE_EVENT_NAME=platform-domain-events
QUEUE_EVENT_JOB_NAME=domain-event
QUEUE_DEAD_LETTER_NAME=platform-dead-letter
QUEUE_DEAD_LETTER_JOB_NAME=dead-letter-event
OUTBOX_RELAY_INTERVAL_MS=5000
OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_RELAY_ENABLED=true

# ─── JWT (config only — no auth implementation in this phase) ─────────────────
JWT_SECRET=changeme-in-production-use-minimum-32-random-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Auth policy (M02) ───────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
PASSWORD_RESET_EXPIRY_HOURS=24
INVITATION_EXPIRY_HOURS=72
# MFA_ENCRYPTION_KEY=  # optional 64-char hex (32 bytes) for TOTP secret encryption

# ─── Email delivery (M02 invitation + password reset) ────────────────────────
# WEB_APP_URL is the frontend origin used in emailed CTA links (not APP_URL/API).
WEB_APP_URL=http://localhost:3000
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=Workforce Cloud OS
EMAIL_FROM_ADDRESS=noreply@localhost
# Optional: write rendered emails to disk for local smoke tests (contains one-time URL tokens).
# EMAIL_CAPTURE_DIR=.email-capture

# ─── API ─────────────────────────────────────────────────────────────────────
API_PREFIX=api
API_VERSION=v1

# ─── Swagger ─────────────────────────────────────────────────────────────────
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_PRETTY=true

# ─── Throttle ────────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── Upload ──────────────────────────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf

# ─── Health ──────────────────────────────────────────────────────────────────
HEALTH_TIMEOUT=3000

# ─── HR Dashboard (SCR-HR-01) ────────────────────────────────────────────────
HR_DASHBOARD_DOCUMENT_EXPIRY_DAYS=30
HR_DASHBOARD_PROBATION_DUE_DAYS=30
HR_DASHBOARD_ATTENDANCE_TREND_DAYS=7
HR_DASHBOARD_HEADCOUNT_GROWTH_MONTHS=6
HR_DASHBOARD_RECENT_ACTIVITY_LIMIT=10

# ─── Web (Next.js public vars) ───────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Workforce Cloud OS
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_VERSION=0.1.0
