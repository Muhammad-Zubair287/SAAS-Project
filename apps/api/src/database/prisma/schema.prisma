  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeId, leaveTypeId, effectiveDate], map: "leave_ledger_entry_tenant_employee_type_effective_idx")
  @@index([tenantId, sourceType, sourceId], map: "leave_ledger_entry_tenant_source_idx")
  @@map("leave_ledger_entry")
}

model LeaveRequest {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  employeeId        String             @map("employee_id") @db.Uuid
  leaveTypeId       String             @map("leave_type_id") @db.Uuid
  policyId          String?            @map("policy_id") @db.Uuid
  startsOn          DateTime           @map("starts_on") @db.Date
  endsOn            DateTime           @map("ends_on") @db.Date
  requestedQuantity Decimal            @map("requested_quantity") @db.Decimal(10, 4)
  reason            String?            @db.Text
  evidenceFileKey   String?            @map("evidence_file_key") @db.VarChar(500)
  emergency         Boolean            @default(false)
  status            LeaveRequestStatus @default(DRAFT)
  submittedAt       DateTime?          @map("submitted_at") @db.Timestamptz(6)
  decidedAt         DateTime?          @map("decided_at") @db.Timestamptz(6)
  decidedBy         String?            @map("decided_by") @db.Uuid
  balanceSnapshot   Json?              @map("balance_snapshot")
  createdBy         String?            @map("created_by") @db.Uuid
  updatedBy         String?            @map("updated_by") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion        BigInt             @default(1) @map("row_version")

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee  Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType         @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  days      LeaveRequestDay[]

  @@index([tenantId, employeeId, startsOn], map: "leave_request_tenant_employee_starts_idx")
  @@index([tenantId, employeeId, status], map: "leave_request_tenant_employee_status_idx")
  @@index([tenantId, status], map: "leave_request_tenant_status_idx")
  @@map("leave_request")
}

model LeaveRequestDay {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  leaveRequestId String             @map("leave_request_id") @db.Uuid
  leaveDate      DateTime           @map("leave_date") @db.Date
  quantity       Decimal            @db.Decimal(10, 4)
  dayPart        LeaveDayPart       @map("day_part")
  holiday        Boolean            @default(false)
  restDay        Boolean            @default(false) @map("rest_day")
  payrollImpact  LeavePayrollImpact @default(NONE) @map("payroll_impact")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@unique([tenantId, leaveRequestId, leaveDate, dayPart], map: "leave_request_day_uq")
  @@index([tenantId, leaveDate], map: "leave_request_day_tenant_date_idx")
  @@map("leave_request_day")
}

model Payslip {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  employeeId       String        @map("employee_id") @db.Uuid
  payrollVersionId String?       @map("payroll_version_id") @db.Uuid
  periodLabel      String        @map("period_label") @db.VarChar(120)
  periodStart      DateTime      @map("period_start") @db.Date
  periodEnd        DateTime      @map("period_end") @db.Date
  currency         String        @db.Char(3)
  grossAmount      Decimal       @map("gross_amount") @db.Decimal(14, 2)
  netAmount        Decimal       @map("net_amount") @db.Decimal(14, 2)
  earnings         Json
  deductions       Json
  status           PayslipStatus @default(GENERATED)
  publishedAt      DateTime?     @map("published_at") @db.Timestamptz(6)
  documentFileKey  String?       @map("document_file_key") @db.VarChar(500)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion       BigInt        @default(1) @map("row_version")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, publishedAt], map: "payslip_tenant_employee_published_idx")
  @@index([tenantId, status], map: "payslip_tenant_status_idx")
  @@map("payslip")
}
