// ─── M07 Phase 1: Shift Foundation ───────────────────────────────────────────
// Versioned working-time definition. Schedule timing lives here; attendance
// evaluation rules live on AttendancePolicy (grace/OT/rounding). Status ACTIVE|INACTIVE.
// Local times stored as HH:MM strings (live AttendancePolicy convention).

model Shift {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                   String    @map("tenant_id") @db.Uuid
  code                       String    @db.VarChar(60)
  name                       String    @db.VarChar(160)
  version                    Int       @default(1)
  status                     String    @default("ACTIVE") @db.VarChar(20)
  startLocalTime             String    @map("start_local_time") @db.VarChar(5)
  endLocalTime               String    @map("end_local_time") @db.VarChar(5)
  crossesMidnight            Boolean   @default(false) @map("crosses_midnight")
  requiredMinutes            Int       @map("required_minutes")
  breakMinutes               Int       @default(0) @map("break_minutes")
  breakPaid                  Boolean   @default(false) @map("break_paid")
  checkInWindowBeforeMinutes Int       @default(0) @map("check_in_window_before")
  checkInWindowAfterMinutes  Int       @default(0) @map("check_in_window_after")
  checkOutWindowAfterMinutes Int       @default(0) @map("check_out_window_after")
  attendancePolicyId         String    @map("attendance_policy_id") @db.Uuid
  effectiveFrom              DateTime  @map("effective_from") @db.Date
  effectiveTo                DateTime? @map("effective_to") @db.Date
  createdBy                  String?   @map("created_by") @db.Uuid
  updatedBy                  String?   @map("updated_by") @db.Uuid
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion                 BigInt    @default(1) @map("row_version")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  attendancePolicy  AttendancePolicy   @relation(fields: [attendancePolicyId], references: [id], onDelete: Restrict)
  assignments       ShiftAssignment[]
  attendanceRecords AttendanceRecord[]
  rosterAssignments RosterAssignment[]
  defaultEmployees  Employee[]         @relation("EmployeeDefaultShift")

  @@unique([tenantId, code, version], map: "shift_tenant_code_version_key")
  @@index([tenantId, status, effectiveFrom], map: "shift_tenant_status_effective_idx")
  @@index([tenantId, code], map: "shift_tenant_code_idx")
  @@index([tenantId, attendancePolicyId], map: "shift_tenant_policy_idx")
  @@map("shift")
}

// ─── M07 Phase 2: Default Shift Assignment ───────────────────────────────────
// Effective-dated DEFAULT working-pattern assignment (not a roster override).
// effectiveFrom inclusive / effectiveTo exclusive (null = open-ended).
// Department bulk = SNAPSHOT expansion to individual employee rows.
// assignmentSource: INDIVIDUAL | DEPARTMENT | DEFAULT. TEAM deferred.

model ShiftAssignment {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  employeeId        String    @map("employee_id") @db.Uuid
  shiftId           String    @map("shift_id") @db.Uuid
  branchId          String?   @map("branch_id") @db.Uuid
  effectiveFrom     DateTime  @map("effective_from") @db.Date
  effectiveTo       DateTime? @map("effective_to") @db.Date
  assignmentSource  String    @map("assignment_source") @db.VarChar(40)
  sourceReferenceId String?   @map("source_reference_id") @db.Uuid
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion        BigInt    @default(1) @map("row_version")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  shift             Shift              @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  branch            Branch?            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  attendanceRecords AttendanceRecord[]

  @@index([tenantId, employeeId, effectiveFrom], map: "shift_assignment_tenant_employee_effective_idx")
  @@index([tenantId, shiftId], map: "shift_assignment_tenant_shift_idx")
  @@index([tenantId, assignmentSource, sourceReferenceId], map: "shift_assignment_tenant_source_idx")
  @@index([tenantId, branchId], map: "shift_assignment_tenant_branch_idx")
  @@map("shift_assignment")
}

// ─── M07 Phase 4: Roster Assignment ──────────────────────────────────────────
// Dated DRAFT/PUBLISHED roster override. Dual-tip markers support PD-5:
// isDraftTip = current correction/new draft tip (attendance-invisible)
// isEffectivePublished = attendance-authoritative published row
// Partial unique indexes enforced in migration SQL.

model RosterAssignment {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  employeeId           String    @map("employee_id") @db.Uuid
  workDate             DateTime  @map("work_date") @db.Date
  shiftId              String?   @map("shift_id") @db.Uuid
  branchId             String?   @map("branch_id") @db.Uuid
  rosterStatus         String    @default("DRAFT") @map("roster_status") @db.VarChar(20)
  isRestDay            Boolean   @default(false) @map("is_rest_day")
  isDraftTip           Boolean   @default(false) @map("is_draft_tip")
  isEffectivePublished Boolean   @default(false) @map("is_effective_published")
  publishedAt          DateTime? @map("published_at") @db.Timestamptz(6)
  publishedBy          String?   @map("published_by") @db.Uuid
  supersedesId         String?   @map("supersedes_id") @db.Uuid
  assignmentSource     String    @map("assignment_source") @db.VarChar(40)
  sourceReferenceId    String?   @map("source_reference_id") @db.Uuid
  createdBy            String?   @map("created_by") @db.Uuid
  updatedBy            String?   @map("updated_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion           BigInt    @default(1) @map("row_version")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  shift             Shift?             @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  branch            Branch?            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supersedes        RosterAssignment?  @relation("RosterSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy      RosterAssignment[] @relation("RosterSupersession")
  attendanceRecords AttendanceRecord[]

  @@index([tenantId, workDate, rosterStatus], map: "roster_assignment_tenant_work_date_status_idx")
  @@index([tenantId, employeeId, workDate], map: "roster_assignment_tenant_employee_work_date_idx")
  @@index([tenantId, shiftId], map: "roster_assignment_tenant_shift_idx")
  @@index([tenantId, branchId], map: "roster_assignment_tenant_branch_idx")
  @@index([tenantId, assignmentSource, sourceReferenceId], map: "roster_assignment_tenant_source_idx")
  @@index([tenantId, supersedesId], map: "roster_assignment_tenant_supersedes_idx")
  @@map("roster_assignment")
}

